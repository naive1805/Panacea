# Supabase project settings — copy to .env.local and fill in.
# Find these under Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-side only key (the Supabase service-role / secret key). It bypasses
# Row Level Security and is used ONLY by server code to write the shared
# medicine-details cache. Never give it a NEXT_PUBLIC_ prefix — that would
# ship it to the browser.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Medicine information provider (drugdb.in / HealthPilot DIS, NRCeS India).
# Open service, no API key needed. Base URL defaults to https://drugdb.in —
# set HEALTHPILOT_BASE_URL only for a self-hosted DISB mirror.
HEALTHPILOT_BASE_URL=
HEALTHPILOT_API_KEY=

# Legacy medicine intelligence (RxNorm + DailyMed, both NIH/NLM) is no longer
# wired into the app — drugdb.in is the active provider. NLM_API_CONTACT is
# kept only for the unused legacy modules. Leave empty.
NLM_API_CONTACT=

# Base URL used in emails and absolute links (e.g. https://panacea.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
